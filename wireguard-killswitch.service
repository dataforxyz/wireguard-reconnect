[Unit]
Description=Pre-arm fail-closed WireGuard nftables kill switch
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
EnvironmentFile=/etc/wireguard-reconnect/environment
ExecStart=/usr/local/bin/wg-killswitch enable ${WIREGUARD_INTERFACE}
RemainAfterExit=yes

[Install]
RequiredBy=network-pre.target
