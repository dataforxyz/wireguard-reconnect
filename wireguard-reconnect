#!/bin/bash
# Privileged WireGuard reconnect helper.
#
# Installed root-owned at /usr/local/bin/wireguard-reconnect and granted
# passwordless pkexec via /etc/polkit-1/rules.d/49-wireguard-reconnect.rules so
# that wireguard-status can connect/disconnect/reconnect hands-free.
#
# Fixed behaviour only: the action is validated against a whitelist and the
# interface against ^wg[0-9]+$ with an existing /etc/wireguard/<iface>.conf.
# No caller-supplied paths or commands are executed, so granting this one
# program passwordless is strictly narrower than passwordless bash.

set -u

VERSION_FILE="${WIREGUARD_RECONNECT_VERSION_FILE:-/usr/local/share/wireguard-reconnect/VERSION}"
LOG_FILE="/run/wireguard-reconnect.log"
FAILURE_STATE="/run/wireguard-reconnect.failure"
LOCK_FILE="/run/wireguard-reconnect.lock"
INTENT_STATE="${WIREGUARD_INTENT_STATE:-/run/wireguard-reconnect.enabled}"
KILLSWITCH_HELPER="/usr/local/bin/wg-killswitch"
PORTAL_HELPER="/usr/local/bin/wireguard-portal"
PORTAL_STATE="/run/wireguard-portal.active"
KILLSWITCH_ENABLED="${WIREGUARD_KILLSWITCH:-1}"
KILLSWITCH_STATE="/run/wg-killswitch.enabled"
KILLSWITCH_ENDPOINT_STATE="/run/wg-killswitch.endpoint"
BOOTSTRAP_DIR="/run/wireguard-reconnect"
TAILSCALE_OPERATOR="${TAILSCALE_OPERATOR:-dxyz}"
CHECK_URL="${WIREGUARD_CHECK_URL:-http://connectivitycheck.gstatic.com/generate_204}"
CHECK_TIMEOUT="${WIREGUARD_CHECK_TIMEOUT:-4}"

ACTION="${1:-}"
IFACE="${2:-wg0}"
PORTAL_URL="${3:-}"
WG_CONF="/etc/wireguard/${IFACE}.conf"

print_version() {
    local fallback
    fallback="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/VERSION"
    if [ -r "$VERSION_FILE" ]; then
        printf 'wireguard-reconnect %s\n' "$(head -n 1 "$VERSION_FILE")"
    elif [ -r "$fallback" ]; then
        printf 'wireguard-reconnect %s\n' "$(head -n 1 "$fallback")"
    else
        printf 'wireguard-reconnect unknown\n'
    fi
}

case "$ACTION" in
    --version|-V|version)
        print_version
        exit 0
        ;;
esac

# Reject anything that is not a plain wgN name so a caller cannot point us at
# an attacker-controlled config (wg-quick configs can contain PostUp scripts).
if ! [[ "$IFACE" =~ ^wg[0-9]+$ ]]; then
    echo "Invalid interface: $IFACE" >"$LOG_FILE"
    exit 2
fi
if [ ! -f "$WG_CONF" ]; then
    echo "No such WireGuard config: $WG_CONF" >"$LOG_FILE"
    exit 2
fi
case "$ACTION" in
    up|down|reconnect|portal) ;;
    *)
        echo "Unknown WireGuard action: $ACTION" >"$LOG_FILE"
        exit 2
        ;;
esac

# Serialize Waybar, boot, resume, and network-monitor requests so two wg-quick
# operations can never rewrite policy routes/nftables at the same time. The
# monitor may inherit fd 5 after atomically checking that the VPN is still stale.
if [ "${WIREGUARD_RECONNECT_LOCK_HELD:-0}" = "1" ]; then
    flock -n 5 || {
        echo "Inherited WireGuard action lock is invalid" >"$LOG_FILE"
        exit 1
    }
    RECONNECT_LOCK_FD=5
else
    exec 9>"$LOCK_FILE"
    if ! flock -w 30 9; then
        echo "Timed out waiting for another WireGuard action" >"$LOG_FILE"
        exit 1
    fi
    RECONNECT_LOCK_FD=9
fi

: >"$LOG_FILE"
chmod 0644 "$LOG_FILE" 2>/dev/null || true

# Every action coordinates with the long-lived portal transaction. In
# particular, an intentional `down` must never disable the host guard while the
# isolated browser namespace still has a forwarded underlay path.
if [ "${WIREGUARD_PORTAL_RESTORE:-0}" = "1" ]; then
    # The portal orchestrator retains fd 8 across its authorized restore so the
    # whole cleanup/reconnect/verification transaction remains atomic.
    flock -n 8 || {
        echo "Inherited captive-portal restore lock is invalid" >"$LOG_FILE"
        exit 1
    }
else
    exec 8>/run/wireguard-portal.lock
fi
if [ "${WIREGUARD_PORTAL_RESTORE:-0}" = "1" ] || flock -n 8; then
    if [ "$ACTION" = "portal" ]; then
        # No live orchestrator owns the lock. Keep it across exec so no second
        # request can enter before the portal helper validates and cleans any
        # stale namespace resources/marker.
        :
    elif [ -f "$PORTAL_STATE" ]; then
        echo "Captive-portal cleanup is incomplete; refusing $ACTION" >"$LOG_FILE"
        exit 1
    fi
else
    echo "Captive-portal mode is active; refusing $ACTION" >"$LOG_FILE"
    exit 1
fi

critical() {
    local message="$*"
    printf 'CRITICAL: %s\n' "$message" >>"$LOG_FILE"
    printf '%s\n' "$message" >"$FAILURE_STATE"
    chmod 0644 "$FAILURE_STATE" 2>/dev/null || true
    logger -p daemon.crit -t wireguard-reconnect "CRITICAL: $message" 2>/dev/null || true
    printf 'wireguard-reconnect: CRITICAL: %s\n' "$message" >&2
}

clear_failure() {
    rm -f "$FAILURE_STATE"
}

# This runtime marker records intent independently of interface health. A
# deliberate disconnect clears it; boot recreates it because VPN-on is the
# default policy for each new system session.
case "$ACTION" in
    up|reconnect|portal)
        printf '%s\n' "$IFACE" >"$INTENT_STATE"
        chmod 0644 "$INTENT_STATE" 2>/dev/null || true
        ;;
    down)
        rm -f "$INTENT_STATE"
        ;;
esac

kill_switch_active() {
    [ -f "$KILLSWITCH_STATE" ] || return 1
    [ -x "$KILLSWITCH_HELPER" ] || return 1
    "$KILLSWITCH_HELPER" status 2>/dev/null | /usr/bin/head -n1 | /usr/bin/grep -q '^enabled'
}

state_value() {
    local key="$1"
    /usr/bin/awk -F= -v key="$key" '$1 == key {print substr($0, length(key) + 2); exit}' "$KILLSWITCH_ENDPOINT_STATE" 2>/dev/null
}

bootstrap_config_for_up() {
    # If the kill switch is already active and wg0 is down, DNS over wlan0 is
    # intentionally blocked. wg-quick cannot resolve a hostname Endpoint in
    # that state, so reuse the last endpoint IP that wg-killswitch recorded
    # while the tunnel was healthy. This keeps reconnect bootstrap limited to
    # the WireGuard server endpoint, not general public internet/DNS.
    local port ep4 ep6 endpoint tmp
    if ! kill_switch_active; then
        printf '%s\n' "$WG_CONF"
        return 0
    fi

    port="$(state_value ENDPOINT_PORT)"
    ep4="$(state_value ENDPOINT4)"
    ep6="$(state_value ENDPOINT6)"
    endpoint=""
    if [ -n "$ep4" ] && [ -n "$port" ]; then
        endpoint="${ep4}:${port}"
    elif [ -n "$ep6" ] && [ -n "$port" ]; then
        endpoint="[${ep6}]:${port}"
    fi

    if [ -z "$endpoint" ]; then
        printf '%s\n' "$WG_CONF"
        return 0
    fi

    /usr/bin/install -d -m 0700 "$BOOTSTRAP_DIR"
    tmp="$BOOTSTRAP_DIR/${IFACE}.conf"
    /usr/bin/awk -v endpoint="$endpoint" '
        /^[[:space:]]*Endpoint[[:space:]]*=/ { print "Endpoint = " endpoint; next }
        { print }
    ' "$WG_CONF" > "$tmp"
    /usr/bin/chmod 0600 "$tmp"
    echo "[#] using cached WireGuard endpoint for kill-switch bootstrap: $endpoint" >>"$LOG_FILE"
    printf '%s\n' "$tmp"
}

wg_quick_up() {
    local conf
    conf="$(bootstrap_config_for_up)"
    /usr/bin/wg-quick up "$conf"
}

vpn_traffic_verified() {
    local code
    ip link show "$IFACE" >/dev/null 2>&1 || return 1
    ip -4 route get 9.9.9.9 2>/dev/null | grep -q " dev ${IFACE}\\b" || return 1
    code="$(curl --interface "$IFACE" --silent --show-error --max-time "$CHECK_TIMEOUT" \
        --output /dev/null --write-out '%{http_code}' "$CHECK_URL" 2>/dev/null || true)"
    [ "$code" = "204" ] || [ "$code" = "200" ]
}

arm_and_verify_kill_switch() {
    [ "$KILLSWITCH_ENABLED" = "1" ] || return 0
    if [ ! -x "$KILLSWITCH_HELPER" ]; then
        critical "kill-switch helper is missing; refusing to bring up $IFACE"
        return 1
    fi

    echo "[#] pre-arming and verifying wg-killswitch for $IFACE" >>"$LOG_FILE"
    if ! /usr/bin/timeout 15s "$KILLSWITCH_HELPER" enable "$IFACE" >>"$LOG_FILE" 2>&1; then
        critical "could not arm and verify the kill switch; refusing to bring up $IFACE"
        return 1
    fi
    if ! kill_switch_active; then
        critical "kill-switch verification failed; refusing to bring up $IFACE"
        return 1
    fi
}

arm_and_verify_portal_guard() {
    [ "$KILLSWITCH_ENABLED" = "1" ] || {
        critical "captive-portal mode requires the kill switch"
        return 1
    }
    if [ ! -x "$KILLSWITCH_HELPER" ]; then
        critical "kill-switch helper is missing; refusing captive-portal mode"
        return 1
    fi

    echo "[#] pre-arming fail-closed host and isolated portal rules for $IFACE" >>"$LOG_FILE"
    # Endpoint DNS is often unavailable before portal authentication. `enable`
    # intentionally returns non-zero in that case but still installs a blocking
    # guard. Portal verification requires the policy-drop host rules and the
    # restricted namespace exception, not a WG endpoint exception yet.
    /usr/bin/timeout 15s "$KILLSWITCH_HELPER" enable "$IFACE" >>"$LOG_FILE" 2>&1 || true
    if ! "$KILLSWITCH_HELPER" status-portal >>"$LOG_FILE" 2>&1; then
        critical "could not verify fail-closed captive-portal isolation"
        return 1
    fi
}

# Connect/reconnect requires the complete endpoint-aware guard. Portal mode can
# safely start with an unresolved endpoint because only its restricted namespace
# is allowed out; the complete guard is required again after login.
case "$ACTION" in
    portal) arm_and_verify_portal_guard || exit 1 ;;
    up|reconnect) arm_and_verify_kill_switch || exit 1 ;;
esac

# Portal mode hands control to a separate fixed root helper after the host guard
# is verified. Release the reconnect lock first: the portal helper reacquires it
# through a normal reconnect after destroying its isolated namespace.
if [ "$ACTION" = "portal" ]; then
    caller_uid="${PKEXEC_UID:-${SUDO_UID:-}}"
    if [ ! -x "$PORTAL_HELPER" ]; then
        critical "captive-portal helper is missing"
        exit 1
    fi
    if ! [[ "$caller_uid" =~ ^[0-9]+$ ]]; then
        critical "could not identify the user requesting captive-portal mode"
        exit 1
    fi
    if [ -f "$PORTAL_STATE" ]; then
        printf 'RECOVERY_STARTED=%s\nCALLER_UID=%s\n' "$(date -Is)" "$caller_uid" >>"$PORTAL_STATE"
    else
        printf 'PHASE=starting\nCALLER_UID=%s\n' "$caller_uid" >"$PORTAL_STATE"
    fi
    chmod 0644 "$PORTAL_STATE"
    flock -u "$RECONNECT_LOCK_FD"
    unset WIREGUARD_RECONNECT_LOCK_HELD
    trap 'rm -f "$PORTAL_STATE"' EXIT
    export WIREGUARD_PORTAL_LOCK_HELD=1
    exec "$PORTAL_HELPER" run "$IFACE" "$PORTAL_URL" "$caller_uid"
fi

# Intentionally disconnecting is the only action that removes the guard. This
# deliberately restores direct internet for captive portals/troubleshooting.
if [ "$ACTION" = "down" ] && [ "$KILLSWITCH_ENABLED" = "1" ]; then
    if [ ! -x "$KILLSWITCH_HELPER" ]; then
        critical "kill-switch helper is missing; refusing an incomplete disconnect"
        exit 1
    fi
    echo "[#] wg-killswitch disable" >>"$LOG_FILE"
    if ! "$KILLSWITCH_HELPER" disable >>"$LOG_FILE" 2>&1; then
        critical "failed to disable the kill switch during intentional disconnect"
        exit 1
    fi
fi

case "$ACTION" in
    up)
        # Another serialized boot/monitor request may have created the interface
        # after the caller decided it was missing. Treat that race as an
        # idempotent success instead of running a stale `wg-quick up` and
        # reporting a false critical failure.
        if ip link show "$IFACE" >/dev/null 2>&1; then
            echo "[#] $IFACE is already present; skipping duplicate up" >>"$LOG_FILE"
        elif ! wg_quick_up >>"$LOG_FILE" 2>&1; then
            critical "wg-quick up $IFACE failed; kill switch remains active"
            exit 1
        fi
        ;;
    down)
        # Treat an already-missing interface as a successful intentional
        # disconnect. The important recovery work above has still cleared VPN
        # intent and disabled the fail-closed guard; reporting failure here used
        # to leave a misleading critical state after resetting a bricked tunnel.
        if ip link show "$IFACE" >/dev/null 2>&1; then
            if ! /usr/bin/wg-quick down "$IFACE" >>"$LOG_FILE" 2>&1; then
                critical "wg-quick down $IFACE failed"
                exit 1
            fi
        else
            echo "[#] $IFACE is already absent; disconnect state is clean" >>"$LOG_FILE"
        fi
        ;;
    reconnect)
        echo "[#] wg-quick down $IFACE" >>"$LOG_FILE"
        /usr/bin/wg-quick down "$IFACE" >>"$LOG_FILE" 2>&1 || true
        sleep 1
        echo "[#] wg-quick up $IFACE" >>"$LOG_FILE"
        if ! wg_quick_up >>"$LOG_FILE" 2>&1; then
            critical "wg-quick reconnect $IFACE failed; kill switch remains active"
            exit 1
        fi
        ;;
esac

# Keep Tailscale online across WireGuard reconnects. Older versions bounced
# Tailscale here, but a failed follow-up "tailscale up" left the node stopped.
if [ -x /usr/bin/tailscale ]; then
    {
        if /usr/bin/tailscale status >/dev/null 2>&1; then
            echo "[#] tailscale already running"
        else
            echo "[#] tailscale up --accept-dns --accept-routes --operator=$TAILSCALE_OPERATOR"
            /usr/bin/tailscale up --accept-dns --accept-routes --operator="$TAILSCALE_OPERATOR" \
                || /usr/bin/tailscale up --accept-dns --accept-routes --operator="$TAILSCALE_OPERATOR" \
                || true
        fi
        /usr/bin/resolvectl flush-caches 2>/dev/null || true
    } >>"$LOG_FILE" 2>&1
fi

# wg-quick chooses policy-rule preferences dynamically and they can move after
# reconnect/sleep. Keep tailnet routes ahead of both wg-quick full-tunnel rules
# so 100.64.0.0/10 peers are never sent into wg0.
wg_first_pref="$({
    /usr/bin/ip -4 rule show | /usr/bin/awk '/lookup main suppress_prefixlength 0/ {sub(":", "", $1); print $1}'
    /usr/bin/ip -4 rule show | /usr/bin/awk '/not from all fwmark .* lookup 51820/ {sub(":", "", $1); print $1}'
} | /usr/bin/sort -n | /usr/bin/head -n1)"
[ -n "$wg_first_pref" ] || wg_first_pref=5185
tail_pref=$((wg_first_pref - 1))

# Remove stale copies at older priorities, then add the one correct priority.
while /usr/bin/ip -4 rule del to 100.64.0.0/10 lookup 52 2>/dev/null; do :; done
/usr/bin/ip -4 rule add pref "$tail_pref" to 100.64.0.0/10 lookup 52 2>/dev/null || true

if /usr/bin/ip -6 route show table 52 | /usr/bin/grep -q "dev tailscale0"; then
    while /usr/bin/ip -6 rule del to fd7a:115c:a1e0::/48 lookup 52 2>/dev/null; do :; done
    /usr/bin/ip -6 rule add pref "$tail_pref" to fd7a:115c:a1e0::/48 lookup 52 2>/dev/null || true
fi

# Refresh and verify again after wg-quick has installed its final fwmark/routes.
# If this verification fails, take wg0 back down while leaving the pre-armed
# guard in place. That is fail-closed: no verified guard means no VPN traffic.
if [ "$ACTION" != "down" ] && [ "$KILLSWITCH_ENABLED" = "1" ]; then
    endpoint_verified=0
    if vpn_traffic_verified; then
        endpoint_verified=1
        echo "[#] WireGuard traffic verified; endpoint cache may be promoted" >>"$LOG_FILE"
    else
        echo "[#] WireGuard traffic is not yet verified; endpoint cache remains unchanged" >>"$LOG_FILE"
    fi

    echo "[#] refreshing and verifying wg-killswitch for $IFACE" >>"$LOG_FILE"
    if ! WIREGUARD_ENDPOINT_VERIFIED="$endpoint_verified" \
        /usr/bin/timeout 15s "$KILLSWITCH_HELPER" enable "$IFACE" >>"$LOG_FILE" 2>&1 || \
       ! kill_switch_active; then
        /usr/bin/wg-quick down "$IFACE" >>"$LOG_FILE" 2>&1 || true
        critical "post-connect kill-switch verification failed; $IFACE was taken down and public traffic remains blocked"
        exit 1
    fi
fi

clear_failure
exit 0
