#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Mark WireGuard as intended-on on every boot and connect it as soon as the
# physical network has a default route. The network monitor handles a late Wi-Fi
# connection if no underlay is ready when this unit first runs.

set -u

IFACE="${WIREGUARD_INTERFACE:-wg0}"
INTENT_STATE="${WIREGUARD_INTENT_STATE:-/run/wireguard-reconnect.enabled}"
SUPPRESS_STATE="${WIREGUARD_AUTOSTART_SUPPRESS_STATE:-/run/wireguard-reconnect.autostart-suppressed}"
RECONNECT_HELPER="${WIREGUARD_RECONNECT_HELPER:-/usr/local/bin/wireguard-reconnect}"
STARTUP_WAIT="${WIREGUARD_STARTUP_WAIT:-30}"
RETRY_IF_LATE="${WIREGUARD_AUTOSTART_RETRY:-0}"

log() {
    logger -t wireguard-autostart "$*" 2>/dev/null || true
    printf 'wireguard-autostart: %s\n' "$*" >&2
}

underlay_online() {
    ip -4 route show table main default 2>/dev/null | \
        awk '$0 !~ / dev (wg[0-9]*|tailscale[0-9]*|tun[0-9]*|tap[0-9]*)/ { found=1 } END { exit !found }'
}

if [ -f "$SUPPRESS_STATE" ]; then
    log "Intentional disconnect is active for this boot; leaving $IFACE off"
    exit 0
fi

install -d -m 0755 "$(dirname "$INTENT_STATE")"
printf '%s\n' "$IFACE" >"$INTENT_STATE"
chmod 0644 "$INTENT_STATE" 2>/dev/null || true

for ((attempt = 0; attempt <= STARTUP_WAIT; attempt++)); do
    if underlay_online; then
        if ip link show "$IFACE" >/dev/null 2>&1; then
            # The event monitor or another boot unit already handled startup.
            # Avoid an unnecessary second bounce; ongoing health checks repair
            # the interface if it is stale.
            log "$IFACE is already present; startup connection is satisfied"
            exit 0
        fi
        log "Physical network ready; enabling $IFACE by default"
        "$RECONNECT_HELPER" auto-up "$IFACE"
        exit $?
    fi
    sleep 1
done

# Keep the intent marker. With automatic reconnect enabled, the monitor handles
# the next physical route event. When the monitor is explicitly disabled, ask
# systemd to retry this bounded oneshot until the boot connection succeeds.
if [ "$RETRY_IF_LATE" = "1" ]; then
    log "No physical default route after ${STARTUP_WAIT}s; scheduling another boot-connect attempt"
    exit 1
fi
log "No physical default route after ${STARTUP_WAIT}s; waiting for network monitor"
exit 0
