[Unit]
Description=Monitor physical network changes and repair WireGuard
After=network.target iwd.service systemd-networkd.service wireguard-killswitch.service
Wants=network.target wireguard-killswitch.service

[Service]
Type=simple
ExecStart=/usr/local/bin/wireguard-monitor
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
